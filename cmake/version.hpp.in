/// @file
/// @brief Compile-time version information, generated by CMake.
///
/// Do not edit: this file is generated from `cmake/version.hpp.in`. The values
/// come from the git tag, see `cmake/GitVersion.cmake`.

#pragma once

#include <string_view>

#include "cpp_library_template/export.hpp"

namespace cpp_library_template {

/// @brief Major version component.
inline constexpr int version_major = @PROJECT_VERSION_MAJOR@;

/// @brief Minor version component.
inline constexpr int version_minor = @PROJECT_VERSION_MINOR@;

/// @brief Patch version component.
inline constexpr int version_patch = @PROJECT_VERSION_PATCH@;

/// @brief Numeric `MAJOR.MINOR.PATCH` version string.
inline constexpr std::string_view version = "@PROJECT_VERSION@";

/// @brief Descriptive version from `git describe`.
///
/// For a build made exactly on a tag this equals ::version. Otherwise it
/// carries the commit distance and hash, e.g. `0.3.1-4-gdeadbee`, and a
/// `-dirty` suffix when the working tree has uncommitted changes.
inline constexpr std::string_view version_full = "@CPP_LIBRARY_TEMPLATE_VERSION_FULL@";

/// @brief The ::version the *library binary* was built with.
///
/// The `constexpr` values above are inlined into the consumer at compile time.
/// These accessors read what the linked library reports, so comparing the two
/// detects a shared library that no longer matches its headers.
///
/// @return Numeric `MAJOR.MINOR.PATCH` version string.
[[nodiscard]] CPP_LIBRARY_TEMPLATE_EXPORT std::string_view compiled_version() noexcept;

/// @brief The ::version_full the library binary was built with.
/// @return Descriptive version from `git describe`.
[[nodiscard]] CPP_LIBRARY_TEMPLATE_EXPORT std::string_view compiled_version_full() noexcept;

}  // namespace cpp_library_template
